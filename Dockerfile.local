ARG PYTORCH_IMAGE=pytorch/pytorch:2.8.0-cuda12.8-cudnn9-devel
FROM ${PYTORCH_IMAGE}

WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_ENDPOINT=https://hf-mirror.com

RUN sed -i \
        -e 's|http://archive.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g' \
        -e 's|http://security.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g' \
        /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    git \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.local.txt /app/requirements.local.txt
RUN python3 -m pip install --no-cache-dir -r /app/requirements.local.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple \
    && python3 -m pip install --no-cache-dir \
        "mmengine>=0.7.1,<1.0.0" \
        "mmcv-lite==2.0.1" \
        "mmdet==3.1.0" \
        "mmpose==1.1.0" \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

COPY . /app
RUN mkdir -p /app/core_data

EXPOSE 8083
CMD ["python3", "-u", "-m", "accelerated.server", "--host", "0.0.0.0", "--port", "8083"]
