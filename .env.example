# Docker Compose 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# GPU 配置
CUDA_VISIBLE_DEVICES=0

# 代理配置（可选，用于下载模型）
HTTP_PROXY=
HTTPS_PROXY=

# HuggingFace 镜像
HF_ENDPOINT=https://hf-mirror.com

# 数据保留时间（秒）
RETENTION_SECONDS=86400

# 端口配置
API_PORT=8000

# 日志级别
LOG_LEVEL=INFO

# LLM 配置位于 llm_inference/.env，不从本文件读取。

# OpenVoice 音色克隆
OPENVOICE_DEVICE=cuda:0
OPENVOICE_DEFAULT_VOICE=default
OPENVOICE_DEFAULT_REFERENCE=D:/code/avatar/MuseTalk/data/input/audio/yongen.wav
OPENVOICE_HEALTH_START_PERIOD=10m
MUSETALK_FPS=25
MUSETALK_BATCH_SIZE=12
PIPELINE_REQUEST_TIMEOUT=300
PIPELINE_FIRST_UNIT_MIN_CHARS=1
PIPELINE_TARGET_UNIT_CHARS=1
PIPELINE_COALESCE_HARD_DELIMITERS=0
